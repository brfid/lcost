#!/bin/sh
# Check staged paths before committing; --all checks tracked paths in CI.
set -eu
forbidden_patterns='(^|/)((ledger|ingest_state)([.-][^/]*)?|recalc-[^/]+)\.json$'

if [ "${1:-}" = "--all" ]; then
    paths=$(git ls-files)
else
    paths=$(git diff --cached --name-only --diff-filter=ACMR)
fi

if printf '%s\n' "$paths" | grep -E "$forbidden_patterns" > /dev/null; then
    echo "ERROR: protected runtime data files must never be committed."
    printf '%s\n' "$paths" | grep -E "$forbidden_patterns"
    exit 1
fi
