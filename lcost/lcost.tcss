/* LCARS (Star Trek TNG) Theme for AI Cost Tracker TUI */

/* ── Color palette ── */
/* Amber: #FF9900  Mauve: #CC6699  Periwinkle: #9999CC
   Peach: #FFCC99  Lavender: #CC99CC  Tan: #CC9966
   Blue:  #6688CC  Red: #CC6666  Pale: #FFCC99 */

Screen {
    background: #000000;
}

/* ── Top bar ── */

/* Single-row top bar: the stardate rides inline with the title instead of
   a 3-tall elbow box, saving two rows. */
#top-bar {
    dock: top;
    height: 1;
    background: #000000;
    layout: horizontal;
}

#top-elbow {
    width: auto;
    height: 1;
    padding: 0 2;
    background: #000000;
    color: #CC6699;
    text-style: bold;
}

#top-title {
    width: auto;
    padding: 0 2;
    height: 1;
    color: #FF9900;
    text-style: bold;
    background: #000000;
}

#top-bar-line {
    width: 1fr;
    height: 1;
    background: #CC6699;
}


/* ── Bottom bar ── */

#bottom-bar {
    dock: bottom;
    height: 1;
    background: #000000;
    layout: horizontal;
}

#bottom-bar-line {
    width: 1fr;
    height: 1;
    background: #9999CC;
}

#bottom-status {
    width: auto;
    padding: 0 2;
    height: 1;
    color: #9999CC;
    background: #000000;
}


/* ── Main content ── */
/* No left rule: the LCARS color language now rides the panel borders
   (amber trend, periwinkle heatmap, mauve elsewhere) instead of a single
   full-height edge bar. Numbers drive the views; no nav rail. */

#main-content {
    margin: 0;
    padding: 0;
    background: #000000;
}


Sparkline {
    height: 3;

    margin: 0 1;
}

Sparkline > .sparkline--max-color {
    color: #FF9900;
}

Sparkline > .sparkline--min-color {
    color: #CC6699;
}

/* ── Chart panels ── */

.chart-panel {
    padding: 0;
    background: #000000;
}

.chart-panel PlotextPlot {
    height: 1fr;
    min-height: 16;
    background: #000000;
}

/* Two-panel stack used by the TOKENS tab: split top/bottom evenly so
   neither sub-chart starves. Each child .chart-panel keeps its own
   plotext sizing rules above. */
.chart-stack {
    layout: vertical;
    height: 1fr;
}

.chart-stack > .chart-panel {
    height: 1fr;
    min-height: 14;
}

.chart-title {
    height: 1;
    color: #FF9900;
    text-style: bold;
    padding: 0 1;
    background: #000000;
}

.chart-subtitle {
    height: 1;
    color: #9999CC;
    padding: 0 1;
    background: #000000;
}

/* ── OPS tab ── */

.ops-kv-line {
    height: 1;

    color: #CC9966;
    padding: 0 1;
}

/* ── Bordered panels with LCARS curves ── */

.ops-panel {
    border: round #CC6699;
    padding: 0 1;
    background: #0a0a0a;
    height: auto;
    border-title-color: #FF9900;
    border-title-style: bold;
    border-subtitle-color: #9999CC;
}

.ops-panel-session {
    height: auto;
    min-height: 8;
    margin: 0 0 1 0;
    padding: 0 1;
}

.ops-stat-row {
    height: 3;
    width: 100%;
    margin: 0;
}

.ops-stat-cell {
    width: 1fr;
    height: 3;
    padding: 0 0 0 1;
    background: #0a0a0a;
    border-left: outer #CC6699;
}

.ops-stat-cell-alt {
    border-left: outer #9999CC;
}

.ops-stat-cell-accent {
    border-left: outer #FF9900;
}

.ops-stat-cell-label {
    height: 1;
    color: #9999CC;
    text-style: bold;
}

.ops-stat-cell-value {
    height: 1;
    color: #FF9900;
    text-style: bold;
}

.ops-stat-cell-detail {
    height: 1;
    color: #CC9966;
}

.ops-hourly-wrap {
    height: 4;
    width: 100%;
    border: round #CC6699;
    border-title-color: #FF9900;
    border-title-style: bold;
    border-subtitle-color: #9999CC;
    padding: 0 1;
    margin-top: 0;
}

.ops-hourly-spark {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.hourly-cell {
    width: 1fr;
    height: 1;
    content-align: center middle;
    background: #050505;
}

.hourly-cell-mark {
    background: #15151f;
}

.ops-hourly-axis {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.hourly-axis {
    width: 1fr;
    height: 1;
    content-align: center middle;
}

/* Fluid bar components */
.fluid-bar {
    width: 1fr;
    height: 1;
}

.bar-cap {
    width: auto;
    height: 1;
}

.ops-hourly-spark > .sparkline--max-color {
    color: #FF9900;
}

.ops-hourly-spark > .sparkline--min-color {
    color: #CC6699;
}

.ops-side-by-side {
    height: auto;
    width: 100%;
    margin: 0;
}

.ops-panel-third {
    width: 1fr;

    height: auto;
    min-height: 5;
    margin: 0 1 0 0;
}

.ops-panel-third:last-of-type {
    margin-right: 0;
}

.ops-labeled-bar {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.panel-row-label {
    width: auto;
    height: 1;
}

.panel-row-footer {
    width: 100%;
    height: 1;
    padding: 0 1;
}

.bar-cap-right {
    width: auto;
    height: 1;
}

.ops-panel-log {
    height: 1fr;
    min-height: 8;
}

/* Fill remaining vertical space — used by CALLS bucket panel so it
   grows with the terminal instead of collapsing to content height. */
.ops-panel-fill {
    height: 1fr;
    min-height: 14;
}

/* CALLS tab: bucket histogram row.
   Wider label cell than the standard ops ranked-panel row so the
   bucket range, count, and share fit without crowding the bar. */
.calls-bucket-row {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.calls-bucket-label {
    width: 38;
    height: 1;
}

.calls-bucket-suffix {
    width: auto;
    height: 1;
    padding: 0 0 0 1;
}

.ops-project-row {
    height: 1;
    color: #FFCC99;
    padding: 0 1;
}

.ops-log-header {
    height: 1;
    color: #9999CC;
    text-style: bold;
    padding: 0 1;
}

.ops-log-row {
    height: 1;
    color: #CC9966;
    padding: 0 1;
}

.ops-log-row-new {
    color: #FFCC99;
    text-style: bold;
}

.ops-log-row-subagent {
    color: #9999CC;
}

.ops-log-row-cont {
    color: #8a7b5c;
}

.ops-log-row-selected {
    background: #FF9900;
    color: #000000;
    text-style: bold;
}

.ops-log-row:hover {
    background: #333333;
}

/* ── HUD layout ── */

/* Top KPI strip: label · value · detail · sparkline */
#hud-kpi-strip {
    height: 6;
    width: 100%;
    layout: horizontal;
    margin: 0;
}


.hud-kpi-cell {
    width: 1fr;
    height: 6;
    padding: 0 0 0 1;
    background: #0a0a0a;
    border-left: outer #CC6699;
}

/* Leftmost cell sits flush with the strip edge — no leading accent tab
   (there's no matching trailing edge on the rightmost cell). The
   inter-cell tabs stay and read as dividers. */
#hud-kpi-strip > .hud-kpi-cell:first-of-type {
    border-left: none;
    padding-left: 2;
}

#hud-source-strip {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: #CC9966;
    background: #11161E;
    border-left: outer #FF9900;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}


.hud-kpi-spark {
    width: 100%;
    height: 2;
    margin: 0 1 0 0;
}

.hud-kpi-spark > .sparkline--max-color { color: #FF9900; }
.hud-kpi-spark > .sparkline--min-color { color: #CC6699; }


.hud-kpi-cell-alt {
    border-left: outer #9999CC;
}

.hud-kpi-cell-accent {
    border-left: outer #FF9900;
}

.hud-kpi-label {
    height: 1;
    color: #9999CC;
    text-style: bold;
}

.hud-kpi-value {
    height: 1;
    color: #FF9900;
    text-style: bold;
}

.hud-kpi-detail {
    height: 1;
    color: #CC9966;
}

/* Middle tier: trend chart + heatmap side by side.
   min-height 18 keeps the trend plot tall enough for plotext to render
   the x-axis date labels — it drops that row first under height pressure,
   and the panel title/subtitle now ride the border instead of eating two
   plot rows. */
#hud-mid {
    height: 1fr;
    min-height: 18;
    layout: horizontal;
    margin: 0;
}


/* Mid-tier borders carry the LCARS color language: amber on the trend
   (cost), periwinkle on the heatmap. Everything else stays mauve. */
#hud-trend {
    width: 1fr;
    height: 100%;
    margin: 0 1 0 0;
    border: round #FF9900;
    border-title-color: #FF9900;
    border-title-style: bold;
    border-subtitle-color: #9999CC;
}

#hud-heatmap {
    width: 1fr;
    height: 100%;
    border: round #9999CC;
    border-title-color: #9999CC;
    border-title-style: bold;
    border-subtitle-color: #CC9966;
}



/* Hourly bar row */
#hud-hourly {
    height: 4;
    width: 100%;
    margin: 0;
}

/* Ranking panels row */
#hud-ranking {
    height: auto;
    width: 100%;
    layout: horizontal;
    margin: 0;
}


/* Call log fills remaining space */
#hud-log {
    height: 1fr;
    min-height: 8;
    width: 100%;
    layout: horizontal;
}

#hud-log-table {
    width: 60%;
    height: 100%;
}

#hud-log-detail {
    width: 40%;
    height: 100%;
    min-height: 8;
    margin-left: 1;
    padding: 0 1;
    border: round #9999CC;
    border-title-color: #FF9900;
    border-subtitle-color: #9999CC;
    background: #0A0A0A;
}

#query-detail-content {
    width: 100%;
    height: auto;
    color: #FFCC99;
    text-wrap: wrap;
}

.hud-detail-collapsed #hud-log-table {
    width: 100%;
}

.hud-detail-collapsed #hud-log-detail,
.hud-compact #hud-log-detail {
    display: none;
}

/* Compact HUD: hide mid tier on short terminals */
.hud-compact #hud-mid {
    display: none;
}

.hud-compact #hud-kpi-strip {
    height: 3;
}

/* ── Entry detail modal ── */

EntryDetailScreen {
    align: center middle;
}

#entry-detail-box {
    width: 80;
    height: auto;
    max-height: 80%;
    border: round #FF9900;
    background: #0a0a0a;
    padding: 1 2;
}

#entry-detail-body {
    color: #FFCC99;
    height: auto;
}

#help-box {
    width: 52;
    height: auto;
    border: round #9999CC;
    background: #0a0a0a;
    padding: 1 2;
}

#help-body {
    color: #FFCC99;
    height: auto;
}
